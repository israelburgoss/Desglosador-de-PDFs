# Copia este archivo a `.env` y completa tus datos.
# ¡NUNCA subas `.env` al repositorio! Está excluido en .gitignore.
#
# Precedencia: una variable real del entorno/shell tiene prioridad sobre el .env

# (OBLIGATORIA solo para el comando extract) Clave de la API.
AI_API_KEY=

# (opcional) Endpoint de la Responses API. Default: OpenAI.
AI_API_URL=https://api.openai.com/v1/responses

# (opcional) Facturas en paralelo durante extract. Default: 5.
MAX_CONCURRENCIA=5